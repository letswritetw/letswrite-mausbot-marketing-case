# Optional. Docker Compose loads .env; direct Python launch does not.
APP_PORT=8801
DASHBOARD_URL=http://localhost:8801/
COOKIE_SECURE=0

# Keep blank to disable email. Configure your own SMTP account to enable it.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=starttls
NOTIFY_POLL_SECONDS=300
